# --- Required ---
# Your custom RMV scheduling URL (the one with the long query string).
RMV_URL=https://rmvmassdotappt.cxmflow.com/...

# ntfy topic URL for notifications.
NTFY_URL=https://ntfy.sh/your-topic

# Comma-separated internal IDs of RMV locations to monitor.
LOCATIONS_TO_MONITOR=12345,67890

# How often to poll, in minutes.
CHECK_FREQUENCY_MINUTES=5

# --- Optional notification filter ---
# Pick ONE of the two modes below. If any NOTIFY_START_DATE / NOTIFY_END_DATE
# is set, the date-range filter takes precedence and NOTIFY_MONTH/NOTIFY_YEAR
# are ignored. Leave everything blank/unset to notify for any date.

# Mode A: month / year filter
# NOTIFY_MONTH: 1-12 or month name (e.g. "April")
# NOTIFY_YEAR:  optional, defaults to current year
#NOTIFY_MONTH=April
#NOTIFY_YEAR=2026

# Mode B: date range filter (YYYY-MM-DD, inclusive on both ends)
# Either bound may be omitted for an open-ended range.
#NOTIFY_START_DATE=2026-04-15
#NOTIFY_END_DATE=2026-05-10
